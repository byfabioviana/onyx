# ============================================================
# Onyx (Jarvis) — Environment Variables
#
# Copie este arquivo para .env e preencha os valores.
# Variaveis marcadas com [OBRIGATORIO] devem ser definidas.
# Variaveis com valores padrao podem ser mantidas como estao.
#
# Para deploy via Portainer, configure estas variaveis
# na aba "Environment variables" da Stack.
# ============================================================

# -- Dominio e Identidade ---------------------------------------
# [OBRIGATORIO] Dominio publico da aplicacao
DOMAIN=jarvis.fabioviana.app.br

# Tag das imagens Docker (latest, craft-latest, ou versao especifica)
IMAGE_TAG=latest

# -- Autenticacao -----------------------------------------------
# Tipo de autenticacao: basic, google_oauth, oidc, saml
AUTH_TYPE=basic

# [OBRIGATORIO] Chave para assinar tokens JWT (gere com: openssl rand -hex 32)
USER_AUTH_SECRET=

# [RECOMENDADO] Chave de encriptacao (gere com: openssl rand -hex 32)
ENCRYPTION_KEY_SECRET=

# Dominios permitidos para signup (separados por virgula, vazio = todos)
# VALID_EMAIL_DOMAINS=

# -- PostgreSQL -------------------------------------------------
POSTGRES_USER=postgres
# [OBRIGATORIO] Senha do PostgreSQL (gere com: openssl rand -hex 16)
POSTGRES_PASSWORD=

# -- OpenRouter (LLM Provider) ---------------------------------
# [OBRIGATORIO] Chave da API OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Headers extras para LiteLLM (formato JSON, opcional)
# LITELLM_EXTRA_HEADERS=

# -- MinIO / S3 (File Storage) ---------------------------------
S3_AWS_ACCESS_KEY_ID=minioadmin
# [OBRIGATORIO] Senha do MinIO (gere com: openssl rand -base64 18)
S3_AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_FILE_STORE_BUCKET_NAME=onyx-file-store-bucket

# -- OpenSearch -------------------------------------------------
OPENSEARCH_ADMIN_PASSWORD=StrongPassword123!

# -- Logging ----------------------------------------------------
LOG_LEVEL=info

# -- Craft (AI-powered web app builder) -------------------------
# Desabilitado por padrao. Para habilitar:
# ENABLE_CRAFT=true
# IMAGE_TAG=craft-latest
ENABLE_CRAFT=false

# -- Code Interpreter -------------------------------------------
CODE_INTERPRETER_IMAGE_TAG=latest

# -- OAuth (se AUTH_TYPE=google_oauth) ---------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# -- OIDC (se AUTH_TYPE=oidc) -----------------------------------
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OPENID_CONFIG_URL=

# -- SMTP (Email) -----------------------------------------------
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# REQUIRE_EMAIL_VERIFICATION=false

# -- Discord Bot (opcional) -------------------------------------
# DISCORD_BOT_TOKEN=
# DISCORD_BOT_INVOKE_CHAR=!

# -- Sentry (opcional) ------------------------------------------
# SENTRY_DSN=

# -- Enterprise (requer licenca paga) ---------------------------
ENABLE_PAID_ENTERPRISE_EDITION_FEATURES=false
